{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kyiv-air-alerts",
  "main": "./public/_worker.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kyiv-air-alerts-history",
      "database_id": "19d12855-54cc-4fc0-9a71-7e617f0793aa"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
