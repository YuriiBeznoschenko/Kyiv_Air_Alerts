{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kyiv-air-alerts",
  "main": "./public/_worker.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
